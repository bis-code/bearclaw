#!/usr/bin/env bash
# claude-setup-doctor — verify the live install matches the repo.
#
# Checks install-copy integrity (install.sh copies, not symlinks), hook
# permissions, JSON validity, MCP availability, settings cascade, marketplace
# reachability. Reports PASS/WARN/FAIL per check; exits non-zero only on FAIL.

set -uo pipefail

DEST="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# Resolve the repo. install.sh copies ~/.claude/bin rather than symlinking
# it, so this doctor is normally run from a real copy that no longer traces
# back to the repo by following symlinks in its own path — read install.sh's
# own record instead (CLAUDE_SETUP_REPO test seam wins when set). Falls back
# to the old cd -P trick for the case this is run directly from a repo
# checkout (e.g. ./bin/claude-setup-doctor during development, where
# .installed-from may be stale or absent).
REPO="${CLAUDE_SETUP_REPO:-}"
if [ -z "$REPO" ] && [ -f "$DEST/.installed-from" ]; then
    REPO="$(sed -n 's/^repo=//p' "$DEST/.installed-from" | head -1)"
fi
# -e, not -d: a git WORKTREE's .git is a plain file, not a directory — -d
# here rejects a worktree-installed repo and silently falls back to $DEST.
if [ -z "$REPO" ] || [ ! -e "$REPO/.git" ]; then
    REPO="$(cd -P "$(dirname "$0")/.." && pwd -P)"
fi
PASS=0; WARN=0; FAIL=0

pass()  { printf '  \033[32mPASS\033[0m  %s\n' "$1"; PASS=$((PASS+1)); }
warn()  { printf '  \033[33mWARN\033[0m  %s\n' "$1"; WARN=$((WARN+1)); }
fail()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; FAIL=$((FAIL+1)); }
group() { printf '\n\033[1m%s\033[0m\n' "$1"; }

group "0. Required tools"
for t in git jq python3; do
    if command -v "$t" >/dev/null 2>&1; then pass "$t"
    else fail "$t missing — required; scripts/bootstrap-deps.sh installs it"; fi
done
for t in gh curl node uv leann bats; do
    if command -v "$t" >/dev/null 2>&1; then pass "$t"
    else warn "$t missing (gh=marketplace checks, node=deep-think server, uv/leann=memory recall, bats=2 test suites) — scripts/bootstrap-deps.sh installs all"; fi
done

group "1. Install copy ($DEST ← $REPO)"
if [ -f "$DEST/.installed-from" ]; then
    INSTALLED_SHA="$(sed -n 's/^sha=//p' "$DEST/.installed-from" | head -1)"
    HEAD_SHA="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)"
    if [ -n "$INSTALLED_SHA" ] && [ -n "$HEAD_SHA" ] && [ "$INSTALLED_SHA" = "$HEAD_SHA" ]; then
        pass ".installed-from matches repo HEAD ($INSTALLED_SHA)"
    elif [ -n "$INSTALLED_SHA" ] && [ -n "$HEAD_SHA" ]; then
        warn ".installed-from sha ($INSTALLED_SHA) != repo HEAD ($HEAD_SHA) — run install.sh"
    else
        warn ".installed-from present but unreadable/repo HEAD unresolvable"
    fi
else
    fail "$DEST/.installed-from missing — run install.sh"
fi
for entry in CLAUDE.md .mcp.json settings.json statusline.sh rules skills hooks agents; do
    dst="$DEST/$entry"; src="$REPO/$entry"
    if [ ! -e "$src" ]; then
        warn "$entry not in repo (skipping)"
        continue
    fi
    if [ -L "$dst" ]; then
        fail "$entry is a symlink (stale — pre-copy install left this) — run install.sh"
    elif [ -e "$dst" ]; then
        pass "$entry present (copy)"
    else
        fail "$entry missing in $DEST — run install.sh"
    fi
done

group "2. Hook scripts executable"
for h in "$REPO"/hooks/*.sh; do
    [ -f "$h" ] || continue
    if [ -x "$h" ]; then pass "$(basename "$h") +x"
    else fail "$(basename "$h") not executable — run install.sh"; fi
done

group "3. JSON validity"
if command -v jq >/dev/null 2>&1; then
    for f in "$REPO"/.mcp.json "$REPO"/settings.json; do
        if jq empty "$f" >/dev/null 2>&1; then pass "$(basename "$f")"
        else fail "$(basename "$f") is malformed JSON"; fi
    done
else
    warn "jq not installed — cannot validate JSON"
fi

group "4. Settings cascade"
SETTINGS="$DEST/settings.json"
if [ ! -f "$SETTINGS" ]; then
    fail "$SETTINGS missing"
else
    AUTO_COMPACT=$(jq -r '.autoCompactWindow // "unset"' "$SETTINGS" 2>/dev/null)
    EFFORT=$(jq -r '.effortLevel // "unset"' "$SETTINGS" 2>/dev/null)
    pass "autoCompactWindow = $AUTO_COMPACT, effortLevel = $EFFORT"
    if [ -f "$DEST/settings.local.json" ]; then
        OVR=$(jq -r 'keys[]' "$DEST/settings.local.json" 2>/dev/null | tr '\n' ' ')
        pass "settings.local.json overrides: $OVR"
    fi
fi

group "5. MCP commands resolvable"
if command -v jq >/dev/null 2>&1 && [ -f "$REPO/.mcp.json" ]; then
    while IFS= read -r cmd; do
        if command -v "$cmd" >/dev/null 2>&1; then pass "MCP command on PATH: $cmd"
        else warn "MCP command NOT on PATH: $cmd (set up the binary or remove the entry)"; fi
    done < <(jq -r '.mcpServers | to_entries[] | .value.command' "$REPO/.mcp.json" 2>/dev/null | sort -u)
fi

group "6. Repo git state"
cd "$REPO"
if [ -z "$(git status --porcelain 2>/dev/null)" ]; then pass "working tree clean"
else warn "uncommitted changes in repo (commit them — there is no autopush)"; fi

# Throttled fetch (once/hour) so ahead/behind sees the OTHER machine's pushes —
# without it "in sync" was vacuously true against a stale remote ref.
FETCH_STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/claude-memory/doctor.fetch.stamp"
mkdir -p "$(dirname "$FETCH_STAMP")" 2>/dev/null
if [ -z "$(find "$FETCH_STAMP" -mmin -60 2>/dev/null)" ]; then
    git fetch --quiet 2>/dev/null && touch "$FETCH_STAMP"
fi
UPSTREAM=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null)
if [ -n "$UPSTREAM" ]; then
    AHEAD=$(git rev-list --count "$UPSTREAM..HEAD" 2>/dev/null || echo 0)
    BEHIND=$(git rev-list --count "HEAD..$UPSTREAM" 2>/dev/null || echo 0)
    if [ "$AHEAD" -eq 0 ] && [ "$BEHIND" -eq 0 ]; then pass "in sync with $UPSTREAM (fetched)"
    elif [ "$BEHIND" -gt 0 ]; then warn "$BEHIND BEHIND $UPSTREAM — run git pull (another machine pushed newer config/memory)${AHEAD:+; $AHEAD ahead}"
    else warn "$AHEAD ahead of $UPSTREAM — push so other machines see it"; fi
fi

group "7. Marketplace reachability (extraKnownMarketplaces)"
if command -v jq >/dev/null 2>&1; then
    # Branch on source type: github → API reachability; directory → local path
    # must exist (a directory-source marketplace has no repo, so the old
    # github.com// assumption produced a spurious FAIL).
    while IFS=$'\t' read -r name type locator; do
        case "$type" in
            github)
                if ! command -v gh >/dev/null 2>&1; then warn "$name → github/$locator (gh not installed, skipped)"
                elif [ -z "$locator" ]; then warn "$name → github source missing repo"
                elif gh api "repos/$locator" >/dev/null 2>&1; then pass "$name → github.com/$locator reachable"
                else fail "$name → github.com/$locator NOT reachable"; fi
                ;;
            directory)
                if [ -z "$locator" ]; then warn "$name → directory source missing path"
                elif [ -d "$locator" ]; then pass "$name → directory $locator exists"
                else fail "$name → directory $locator MISSING"; fi
                ;;
            *) warn "$name → unknown marketplace source type: ${type:-none}" ;;
        esac
    done < <(jq -r '.extraKnownMarketplaces // {} | to_entries[] | "\(.key)\t\(.value.source.source // "?")\t\(.value.source.repo // .value.source.path // "")"' "$SETTINGS" 2>/dev/null)
fi

group "8. Claude CLI (version + hook-key compatibility)"
MIN_CLAUDE_VERSION="$(grep -m1 '^MIN_CLAUDE_VERSION=' "$REPO/install.sh" | cut -d'"' -f2)"
# Hook events known to claude >= MIN_CLAUDE_VERSION. An event key the running
# CLI does not know makes it DISCARD the entire settings.json (observed
# 2026-08-16: v2.1.29 vs PostCompact — every hook silently dead). Adding a new
# event to settings.json requires consciously updating this list + the constant.
KNOWN_HOOK_EVENTS="PreToolUse PostToolUse PostToolUseFailure PostToolBatch Notification UserPromptSubmit UserPromptExpansion SessionStart SessionEnd Stop StopFailure SubagentStart SubagentStop PreCompact PostCompact PermissionRequest PermissionDenied Setup TeammateIdle TaskCreated TaskCompleted Elicitation ElicitationResult ConfigChange WorktreeCreate WorktreeRemove InstructionsLoaded CwdChanged FileChanged DirectoryAdded MessageDisplay"
if ! command -v claude >/dev/null 2>&1; then
    fail "claude CLI not on PATH — install.sh installs it (or https://claude.ai/install.sh)"
else
    CUR="$(claude --version 2>/dev/null | awk '{print $1; exit}')"
    if [ -z "$CUR" ]; then
        warn "claude --version output unparseable"
    elif [ -n "$MIN_CLAUDE_VERSION" ] && [ "$(printf '%s\n%s\n' "$MIN_CLAUDE_VERSION" "$CUR" | sort -V | head -1)" = "$CUR" ] && [ "$CUR" != "$MIN_CLAUDE_VERSION" ]; then
        fail "claude $CUR < required $MIN_CLAUDE_VERSION — a too-old CLI rejects newer hook keys and discards the WHOLE settings.json. Run: claude update"
    else
        pass "claude $CUR >= required ${MIN_CLAUDE_VERSION:-unset}"
    fi
    if command -v jq >/dev/null 2>&1; then
        UNKNOWN=""
        for k in $(jq -r '.hooks // {} | keys[]' "$REPO/settings.json" 2>/dev/null); do
            case " $KNOWN_HOOK_EVENTS " in
                *" $k "*) ;;
                *) UNKNOWN="$UNKNOWN $k" ;;
            esac
        done
        if [ -n "$UNKNOWN" ]; then
            fail "settings.json hook key(s) not in the known-events allowlist:$UNKNOWN — verify CLI support, then update KNOWN_HOOK_EVENTS + MIN_CLAUDE_VERSION"
        else
            pass "all settings.json hook keys within the known-events allowlist"
        fi
    fi
fi

group "9. Plugins (enabledPlugins vs installed)"
if command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    INSTALLED=$(claude plugin list 2>/dev/null)
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        if printf '%s' "$INSTALLED" | grep -qF "$p"; then pass "$p installed"
        else fail "$p enabled but NOT installed — run bin/claude-plugin-sync"; fi
    done < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value==true) | .key' "$REPO/settings.json" 2>/dev/null)
else
    warn "claude or jq unavailable — plugin parity not checked"
fi

group "10. Memory index"
IDXNAME="$(basename "$DEST" | sed 's/^\.//')-memory-global"
MEMSTATE="${XDG_STATE_HOME:-$HOME/.local/state}/claude-memory"
if ! command -v leann >/dev/null 2>&1; then
    warn "leann not installed — recall disabled (recipe: memory-global/ERRORS.md incl. Linux/CPU notes)"
elif [ -f "$MEMSTATE/$IDXNAME.build.err" ]; then
    fail "index build failing: $(head -1 "$MEMSTATE/$IDXNAME.build.err") (log: $MEMSTATE/$IDXNAME.build.log)"
elif [ ! -f "$MEMSTATE/$IDXNAME.built" ]; then
    warn "no build stamp yet — first build runs at next session start"
else
    NEWEST=$(find "$DEST/memory-global/" -name '*.md' -newer "$MEMSTATE/$IDXNAME.built" 2>/dev/null | head -1)
    if [ -z "$NEWEST" ]; then pass "index fresh (stamp newer than corpus)"
    else warn "index stale (memory edited since last build — rebuilds at next session start)"; fi
fi

# Audit cadence: compare the newest docs/audits filename date (YYYY-MM) to now —
# file mtimes are useless across clones. >45 days ≈ months apart >= 2.
LATEST_AUDIT=$(ls -1 "$REPO"/docs/audits/2*-*audit*.md 2>/dev/null | sort | tail -1)
if [ -n "$LATEST_AUDIT" ]; then
    A_Y=$(basename "$LATEST_AUDIT" | cut -d- -f1); A_M=$(basename "$LATEST_AUDIT" | cut -d- -f2)
    N_Y=$(date +%Y); N_M=$(date +%m)
    MONTHS_APART=$(( (N_Y*12 + ${N_M#0}) - (A_Y*12 + ${A_M#0}) ))
    if [ "$MONTHS_APART" -ge 2 ]; then
        warn "latest setup audit is $(basename "$LATEST_AUDIT") (~$MONTHS_APART months old) — run monthly-setup-audit"
    else
        pass "setup audit cadence ok ($(basename "$LATEST_AUDIT"))"
    fi
fi

group "11. Line endings (CRLF poisoning)"
# A Windows-side checkout copied into WSL/macOS breaks every #!/bin/sh hook
# with invisible \r. .gitattributes prevents NEW poisoning; this catches an
# already-poisoned tree in seconds instead of via mysterious hook failures.
CRLF_HITS=$(git -C "$REPO" grep -lI $'\r' -- . 2>/dev/null | head -5)
if [ -z "$CRLF_HITS" ]; then
    pass "no CRLF in tracked text files"
else
    fail "CRLF in tracked files: $(printf '%s' "$CRLF_HITS" | tr '\n' ' ') — fix: git -C $REPO add --renormalize . && git -C $REPO checkout -- . (or re-clone inside WSL)"
fi

group "12. bearclaw drift (public twin)"
BEARCLAW="${BEARCLAW_CLONE:-}"
if [ -z "$BEARCLAW" ]; then
    # Only the sibling location, which is relative to this repo and so holds
    # on any layout. Anywhere else: set BEARCLAW_CLONE. Guessing absolute
    # paths here just encodes one machine's directory tree.
    [ -d "$REPO/../bearclaw/.git" ] && BEARCLAW="$REPO/../bearclaw"
fi
if [ -z "$BEARCLAW" ]; then
    pass "no local bearclaw clone — drift not checked on this machine"
else
    DRIFT_OUT=$(bash "$REPO/scripts/bearclaw-drift.sh" "$BEARCLAW" 2>/dev/null)
    DRIFT_N=$(printf '%s' "$DRIFT_OUT" | grep -cE '^\s+[a-zA-Z0-9._/-]+' 2>/dev/null)
    DRIFT_MAX="${BEARCLAW_DRIFT_MAX:-10}"
    if [ "${DRIFT_N:-0}" -gt "$DRIFT_MAX" ]; then
        warn "bearclaw drift: ~$DRIFT_N files out of sync (> $DRIFT_MAX) — run the sync pass (docs/bearclaw-sync.md)"
    else
        pass "bearclaw drift within threshold (~${DRIFT_N:-0} files)"
    fi
fi

printf '\n\033[1mSummary:\033[0m \033[32m%d pass\033[0m, \033[33m%d warn\033[0m, \033[31m%d fail\033[0m\n' "$PASS" "$WARN" "$FAIL"
exit "$FAIL"
