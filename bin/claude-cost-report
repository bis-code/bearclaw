#!/bin/sh
# claude-cost-report — summarize Claude Code spend from metrics/costs.jsonl
# (written by the cost-tracker Stop hook as per-turn DELTA rows, so plain SUM
# + date-filter is correct).
#
# Usage:
#   claude-cost-report        # summary + by-project (7d) + last-7-days
#   claude-cost-report csv     # last 100 rows as CSV
#
# CLAUDE_METRICS_DIR overrides the metrics dir (default ~/.claude/metrics).

set -e

METRICS_DIR="${CLAUDE_METRICS_DIR:-$HOME/.claude/metrics}"
FILE="$METRICS_DIR/costs.jsonl"
MODE="${1:-summary}"

if [ ! -f "$FILE" ]; then
    echo "No cost data yet ($FILE not found)."
    echo "The cost-tracker Stop hook writes a row after each turn — check back later."
    exit 0
fi

TODAY=$(date +%F)
CUT7=$(date -v-6d +%F 2>/dev/null || date -d '6 days ago' +%F)

if [ "$MODE" = "csv" ]; then
    echo "timestamp,project,model,input_tokens,output_tokens,cache_write_tokens,cache_read_tokens,estimated_cost_usd"
    jq -r '[.timestamp,.project,.model,.input_tokens,.output_tokens,.cache_write_tokens,.cache_read_tokens,.estimated_cost_usd]|@csv' "$FILE" 2>/dev/null | tail -100
    exit 0
fi

# Summary (today / last-7d / all-time / counts). usd = round to 4 dp.
jq -rs --arg today "$TODAY" --arg cut "$CUT7" '
  def usd: (. * 10000 | round) / 10000;
  ([.[] | select(.timestamp[0:10] == $today) | .estimated_cost_usd] | add // 0) as $t |
  ([.[] | select(.timestamp[0:10] >= $cut)   | .estimated_cost_usd] | add // 0) as $w |
  ([.[] | .estimated_cost_usd] | add // 0) as $all |
  "Cost report\n-----------\nToday:    $\($t|usd)\nLast 7d:  $\($w|usd)\nAll-time: $\($all|usd)\nRows: \(length)  Sessions: \([.[].session_id]|unique|length)"
' "$FILE"

echo
echo "By project (last 7d):"
jq -rs --arg cut "$CUT7" '
  def usd: (. * 10000 | round) / 10000;
  [.[] | select(.timestamp[0:10] >= $cut)]
  | group_by(.project)
  | map({p: .[0].project, c: ([.[].estimated_cost_usd] | add)})
  | sort_by(-.c)[]
  | "  \(.p): $\(.c|usd)"
' "$FILE"

echo
echo "Last 7 days:"
jq -rs --arg cut "$CUT7" '
  def usd: (. * 10000 | round) / 10000;
  [.[] | select(.timestamp[0:10] >= $cut)]
  | group_by(.timestamp[0:10])
  | map({d: .[0].timestamp[0:10], c: ([.[].estimated_cost_usd] | add)})
  | sort_by(.d) | reverse[]
  | "  \(.d): $\(.c|usd)"
' "$FILE"

# Footer: warn if the tracker logged any write failures.
if [ -s "$METRICS_DIR/cost-tracker.log" ]; then
    echo
    echo "⚠ cost-tracker logged write errors — see $METRICS_DIR/cost-tracker.log"
fi
